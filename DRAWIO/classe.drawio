        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagramme de classes - AGTS\n&#39; Définition des classes principales du système\nclass Utilisateur {\n  - id : int\n  __\n  - nom : String\n  - prenom : String\n  - email : String\n  - motDePasse : String\n  --\n  + seConnecter()\n  + seDeconnecter()\n}\n\nclass Etudiant {\n  - matricule : String\n  __\n  - quartier : String\n  --\n  + suivreBus()\n}\n\nclass Chauffeur {\n  - idBus : int\n  __\n  - position : String\n  --\n  + envoyerPosition()\n}\n\nclass Bus {\n  - idBus : int\n  __\n  - capacite : int\n  - positionGPS : String\n  - statut : String\n  --\n  + demarrerTrajet()\n  + arreterTrajet()\n}\n\nclass Trajet {\n  - idTrajet : int\n  __\n  - heureDepart : DateTime\n  - heureArrivee : DateTime\n  - arrets : List&lt;String&gt;\n  --\n  + planifier()\n  + afficherStat()\n}\n\nUtilisateur &lt;|-- Etudiant : hérite\nUtilisateur &lt;|-- Chauffeur : hérite\nBus \&quot;1\&quot; -- \&quot;1..*\&quot; Trajet : réalise\nChauffeur \&quot;1\&quot; -- \&quot;1\&quot; Bus : conduit\nEtudiant \&quot;1\&quot; -- \&quot;1\&quot; Bus : suit\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="vZQ88qHuY1XUzzK73TSN-2">
